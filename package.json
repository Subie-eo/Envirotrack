{
  "name": "envirotrack",
  "version": "1.0.0",
  "description": "Envirotrack is a real-time weather monitoring dashboard that combines live weather data with a simulator and analytics views.",
  "private": true,
  "author": "Subie-eo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Subie-eo/Envirotrack.git"
  },
  "homepage": "https://github.com/Subie-eo/Envirotrack#readme",
  "bugs": {
    "url": "https://github.com/Subie-eo/Envirotrack/issues"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm start",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "node backend/dist/server.js"
  },
  "keywords": [
    "weather",
    "station",
    "iot",
    "dashboard",
    "monitoring",
    "environment",
    "open-meteo"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.1"
  }
}
